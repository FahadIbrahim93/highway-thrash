{
  "name": "highway-thrash",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Highway Thrash — Road Rash spiritual successor fused with Traffic Racer. Pure web PWA motorcycle combat racing.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test": "echo \"ScoreSystem tests available in src/systems/__tests__/ScoreSystem.test.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.172.0",
    "zustand": "^5.0.3",
    "howler": "^2.2.4"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.1",
    "workbox-window": "^7.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
